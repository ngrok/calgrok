		"@tanstack/react-query": "5.101.1",
		"date-fns": "4.4.0",
		"dotenv": "17.4.2",
		"isbot": "5.1.44",
		"react": "19.2.7",
		"react-dom": "19.2.7",
		"react-router": "7.18.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.1",
