# Slated reaches Linear one of two ways. Fill in ONE of the two blocks below,
# or run `pnpm setup:env` to have this written for you.
#
# Not sure which? Use the solo block. Switch to OAuth when other people need in.

# ---------------------------------------------------------------------------
# Solo: a personal API key. One value, no OAuth app.
# ---------------------------------------------------------------------------
# Create a key at https://linear.app/settings/api
#
# Setting this puts Slated in single-user mode: there is no sign-in, and
# everyone who reaches the server acts as the key's owner. Keep it on localhost
# or behind your own access control.
#
# If that page will not issue you a key, your Linear admin has turned off member
# API keys (Settings > Administration > API > Member API keys). Use the OAuth
# block below instead; it needs no admin involvement.
LINEAR_API_KEY=

# ---------------------------------------------------------------------------
# Team: a Linear OAuth app. Each person signs in as themselves.
# ---------------------------------------------------------------------------
# Create the app at https://linear.app/settings/api/applications/new with:
#   Redirect URI: http://localhost:3000/auth/linear/callback
#                 (plus your deployed callback URL, once you have one)
#   Scopes:       read, write
#
# Used only when LINEAR_API_KEY is empty. All four are then required.
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_REDIRECT_URI=http://localhost:3000/auth/linear/callback

# Signs the cookie that carries each visitor's Linear tokens. Changing it signs
# everyone out. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Optional, for either mode
# ---------------------------------------------------------------------------

# Comma-separated team keys (for example, GTM,CON) preselected on a visitor's
# first load. Every team they can see stays available to toggle; this only seeds
# the initial view. Leave blank to start with none selected.
LINEAR_TEAM_DEFAULT=

# When set (for example, con/), only labels under this namespace are offered,
# the prefix is stripped in the UI, and unfiltered views are scoped to issues
# carrying one of those labels. Leave blank to show all dated issues from the
# selected teams.
LINEAR_LABEL_NAMESPACE=
