# Linear OAuth app credentials (from linear.app/settings/api/applications/new)
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_REDIRECT_URI=http://localhost:3000/auth/linear/callback

# Secret used to sign/encrypt the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
