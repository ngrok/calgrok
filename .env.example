# Slated needs one value: a personal Linear API key. Run `pnpm setup:env` to
# have this file written for you.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
# Create a key at https://linear.app/settings/api
#
# There is no sign-in. Slated acts as this key's owner, so everyone who reaches
# the server gets your read and write access to the workspace. Keep it on
# localhost, or put your own access control in front of it (see "Deploying" in
# the README).
#
# If that page will not issue you a key, your Linear admin has turned off member
# API keys, under Settings > Administration > API.
LINEAR_API_KEY=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Comma-separated team keys (for example, GTM,CON) preselected on a visitor's
# first load. Every team stays available to toggle; this only seeds the initial
# view. Leave blank to start with none selected.
LINEAR_TEAM_DEFAULT=

# When set (for example, con/), only labels under this namespace are offered,
# the prefix is stripped in the UI, and unfiltered views are scoped to issues
# carrying one of those labels. Leave blank to show all dated issues from the
# selected teams.
LINEAR_LABEL_NAMESPACE=

# The project label (for example, Content) that decides which Linear projects
# reach the calendar. Projects are placed by their target date, filtered by the
# selected teams and then by this label. Project labels are workspace-level, so
# this is a name, not a per-team label. Several names can be comma-separated.
# Leave blank to offer every project the selected teams can see. Visitors can
# hide projects entirely under Options > Show projects.
LINEAR_PROJECT_LABEL=
