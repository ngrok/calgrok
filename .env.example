# Linear OAuth app credentials (from linear.app/settings/api/applications/new)
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_REDIRECT_URI=http://localhost:3000/auth/linear/callback

# Secret used to sign/encrypt the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional. When set (for example, con/), the calendar only shows issues with
# labels under this namespace by default and strips the prefix in the UI. Leave
# blank to show selected teams' dated issues without a required label match.
LINEAR_LABEL_NAMESPACE=

# Optional. Comma-separated team keys (for example, GTM,CON) selected by default
# on a visitor's first load. Every team they can see in the workspace stays
# available to toggle; this only seeds the initial view. Leave blank for none.
LINEAR_TEAM_DEFAULT=
